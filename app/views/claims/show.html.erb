<%= link_to "← Back home", root_path, class: "text-sm text-blue-600" %>

<h1 class="mt-4 text-xl font-bold"><%= @claim.item.title %></h1>
<p class="text-gray-700"><%= @claim.item.description %></p>
<p class="text-sm text-gray-500"><%= @claim.item.category %></p>

<p class="mt-6 rounded bg-gray-100 px-4 py-2"><%= @claim.story %></p>

<dl class="mt-4 grid grid-cols-2 gap-1 text-sm">
  <dt class="text-gray-500">Plausible</dt><dd><%= number_to_percentage(@claim.plausible * 100, precision: 0) %></dd>
  <dt class="text-gray-500">Match</dt><dd><%= number_to_percentage(@claim.match * 100, precision: 0) %></dd>
  <dt class="text-gray-500">Specificity</dt><dd><%= number_to_percentage(@claim.specificity * 100, precision: 0) %></dd>
</dl>
